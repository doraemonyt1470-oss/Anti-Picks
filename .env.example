# ==============================================================================
# ANTI PICKS Environment Variables Template
# Copy this file to .env and configure your values.
# NEVER commit .env to version control or expose service role keys on the client!
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Admin Secret Key (used for backend admin API verification)
ADMIN_SECRET=your-secure-admin-secret-min-32-chars-long

# Supabase Credentials (from your Supabase Project Settings -> API)
# Required for connecting to remote Supabase instance
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Vite Public Environment Variables (prefixed with VITE_)
# Only safe public variables can be exposed to Vite
VITE_API_URL=http://localhost:5000

